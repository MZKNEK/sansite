{
    "swagger": "2.0",
    "info": {
        "version": "1.0",
        "title": "Sanakan API",
        "description": "Autentykacja następuje poprzez dopasowanie tokenu przesłanego w nagłówku `x-api-key`.\n\nDocelowa wersja api powinna zostać przesłana pod nagówkiem `x-api-version`, w przypadku jej nie podania zapytania są interpretowane jako wysłane do wersji `1.0`."
    },
	"host": "http://api.sanakan.pl/",
    "paths": {
        "/api/Msg/user/{id}": {
            "post": {
                "tags": [
                    "Msg"
                ],
                "summary": "Wysyła wiadomość do uzytkownika o podanym id",
                "description": "Użytkownik musi znajdować się na serwerze, inaczej operacja się nie powiedzie",
                "operationId": "ApiMsgUserByIdPost",
                "consumes": [
                    "application/json-patch+json",
                    "application/json",
                    "text/json",
                    "application/*+json"
                ],
                "produces": [],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id użytkownika discorda",
                        "required": true,
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "name": "value",
                        "in": "body",
                        "description": "Treść wiadomość",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                },
                "deprecated": true
            }
        },
        "/api/Msg/{id}": {
            "post": {
                "tags": [
                    "Msg"
                ],
                "summary": "Wysyła wiadomość na kanał o podanym id",
                "description": "Użytkownik musi znajdować się na serwerze, inaczej operacja się nie powiedzie",
                "operationId": "ApiMsgByIdPost",
                "consumes": [
                    "application/json-patch+json",
                    "application/json",
                    "text/json",
                    "application/*+json"
                ],
                "produces": [],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id kanału discorda",
                        "required": true,
                        "type": "integer",
                        "format": "int64"
                    },
                    {
                        "name": "value",
                        "in": "body",
                        "description": "Treść wiadomość",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    }
                },
                "deprecated": true
            }
        },
        "/api/RichMessage": {
            "get": {
                "tags": [
                    "RichMessage"
                ],
                "summary": "Zwraca przykładową wiadomość typu RichMessage",
                "operationId": "ApiRichMessageGet",
                "consumes": [],
                "produces": [
                    "text/plain",
                    "application/json",
                    "text/json"
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "$ref": "#/definitions/RichMessage"
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "RichMessage"
                ],
                "summary": "Wysyła wiadomość typu RichMessage",
                "description": "Do utworzenia wiadomości wystarczy ustawić jej typ oraz, podać opis.\r\nJeśli chcemy aby link z pola Url zadziałał to należy również sprecyzować tytuł wiadomości.",
                "operationId": "ApiRichMessagePost",
                "consumes": [
                    "application/json-patch+json",
                    "application/json",
                    "text/json",
                    "application/*+json"
                ],
                "produces": [],
                "parameters": [
                    {
                        "name": "message",
                        "in": "body",
                        "description": "wiadomość",
                        "required": false,
                        "schema": {
                            "$ref": "#/definitions/RichMessage"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/api/User/all": {
