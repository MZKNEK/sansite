    "definitions": {
        "RichMessage": {
            "description": "Wiadomośc Embed generowane przez discorda, jedno z pól opcjonalnych musi zostać sprecyzowane",
            "type": "object",
            "properties": {
                "url": {
                    "description": "Adres do kótego prowadzi tytuł wiadomości, opcjonalne",
                    "type": "string"
                },
                "title": {
                    "description": "Tytuł wiadomości, opcjonalne",
                    "type": "string"
                },
                "imageUrl": {
                    "description": "Adres obrazka wyświetlanego na końcu wiadomości, opcjonalne",
                    "type": "string"
                },
                "description": {
                    "description": "Główna treść wiadomości, opcjonalne",
                    "type": "string"
                },
                "author": {
                    "$ref": "#/definitions/RichMessageAuthor",
                    "description": "Autor wiadomości - pierwsza linia, opcjonalne"
                },
                "footer": {
                    "$ref": "#/definitions/RichMessageFooter",
                    "description": "Stopka wiadomości - ostatnia linia, opcjonalne"
                },
                "fields": {
                    "$ref": "#/definitions/RichMessageFields",
                    "description": "Dodatkowe pola, opcjonalne"
                },
                "messageType": {
                    "description": "Typ wiadomości, musi zostać podany (int od 0)",
                    "enum": [
                        "NEWS",
                        "NEW_EPISODE",
                        "LAUD_NOTIFY",
                        "MODERATOR_NOTIFY",
                        "NEW_SEASONAL_EPISODE",
                        "ADMINISTRATOR_NOTIFY"
                    ],
                    "type": "string"
                }
            }
        },
        "RichMessageAuthor": {
            "description": "Autor wiadomości - pierwsza linia, opcjonalne",
            "type": "object",
            "properties": {
                "name": {
                    "description": "Tekst pierwszej lini",
                    "type": "string"
                },
                "isAuthor": {
                    "description": "Czy wyświetlić autora",
                    "type": "boolean"
                },
                "imageUrl": {
                    "description": "Obrazek przy pierwszej lini",
                    "type": "string"
                }
            }
        },
        "RichMessageFooter": {
            "description": "Stopka wiadomości - ostatnia linia, opcjonalne",
            "type": "object",
            "properties": {
                "text": {
                    "description": "Tesks ostatniej lini",
                    "type": "string"
                },
                "isFooter": {
                    "description": "Czy wyświetlić stopke",
                    "type": "boolean"
                },
                "imageUrl": {
                    "description": "Obrazek ostatniej lini",
                    "type": "string"
                }
            }
        },
        "RichMessageFields": {
            "description": "Dodatkowe pola, opcjonalne",
            "type": "object",
            "properties": {
                "hasFields": {
                    "description": "Czy wyświetlić dodatkowe pola wiadomości",
                    "type": "boolean"
                },
                "fields": {
                    "description": "Lista dodatkowych pól wiadomości",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RichMessageField"
                    }
                }
            }
        },
        "RichMessageField": {
            "description": "Dodatkowe pole wiadomości",
            "type": "object",
            "properties": {
                "name": {
                    "description": "Nagłówek dodatkowego pola",
                    "type": "string"
                },
                "value": {
                    "description": "Tekst dodatkowego pola",
                    "type": "string"
                },
                "isInline": {
                    "description": "Czy pole może zostać wyświetlne w jednej lini z innymi",
                    "type": "boolean"
                }
            }
        },
        "BotUser": {
            "type": "object",
            "properties": {
                "user_id": {
                    "$ref": "#/definitions/UserID"
                },
                "discord_user_attributes": {
                    "$ref": "#/definitions/DiscordUserAttributes"
                },
                "discord_user_achievements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/AchievementBase"
                    }
                },
                "custom_bg": {
                    "type": "boolean"
                },
                "bg_image": {
                    "type": "string"
                },
                "inside_type": {
                    "enum": [
                        "STATS",
                        "IMG"
                    ],
                    "type": "string"
                },
                "custom_in_img": {
                    "type": "boolean"
                },
                "in_image": {
                    "type": "string"
                },
                "used_wheel": {
                    "format": "date-time",
                    "type": "string"
                },
                "used_hourly": {
                    "format": "date-time",
                    "type": "string"
                },
                "can_gamble": {
                    "type": "boolean"
                },
                "broken": {
                    "type": "boolean"
                },
                "premium": {
                    "format": "date-time",
                    "type": "string"
                },
                "rep_giv": {
                    "format": "int32",
                    "type": "integer"
                },
                "bankrupt_to": {
                    "format": "date-time",
                    "type": "string"
                }
            }
        },
        "UserID": {
            "type": "object",
            "properties": {
                "discord_id": {
                    "format": "int64",
                    "type": "integer"
                },
                "shinden_id": {
                    "format": "int64",
                    "type": "integer"
                }
            }
        },
        "DiscordUserAttributes": {
            "type": "object",
            "properties": {
                "user_exp_points": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_level": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_messeges": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_reputation": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_reputation_last_time_granted": {
                    "format": "date-time",
                    "type": "string"
                },
                "user_wallet": {
                    "format": "int64",
                    "type": "integer"
                },
                "wallet_daily_used": {
                    "format": "date-time",
                    "type": "string"
                },
                "money_lost_on_lottery": {
                    "format": "int64",
                    "type": "integer"
                }
            }
        },
        "AchievementBase": {
            "type": "object",
            "properties": {
                "ach_type": {
                    "enum": [
                        "MONEY_LOST",
                        "MONEY",
                        "LOSES_MASTER",
                        "MONEY_MASTER",
                        "MESSEGES",
                        "LOAN",
                        "LIKED",
                        "JACKPOT"
                    ],
                    "type": "string"
                },
                "ach_value": {
                    "format": "int64",
                    "type": "integer"
                },
                "ach_event": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "api-key": {
            "name": "x-api-key",
            "in": "header",
            "type": "apiKey"
        }
    },
    "security": [
        {
            "api-key": [
                "readAccess",
                "writeAccess"
            ]
        }
    ]
}