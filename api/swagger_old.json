    "definitions": {
        "RichMessage": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "example": "https://shinden.pl/news/284"
                },
                "title": {
                    "type": "string",
                    "example": "Strike the Blood III na oficjalnej stronie!"
                },
                "imageUrl": {
                    "type": "string",
                    "example": "https://i.imgur.com/y7givUs.png"
                },
                "description": {
                    "type": "string",
                    "example": "Oficjalna strona pozycji niedawno opublikowała informację, że podjęli decyzję o produkcji."
                },
                "author": {
                    "$ref": "#/definitions/RichMessageAuthor"
                },
                "footer": {
                    "$ref": "#/definitions/RichMessageFooter"
                },
                "fields": {
                    "$ref": "#/definitions/RichMessageFields"
                },
                "messageType": {
                    "format": "int32",
                    "enum": [
                        "0 => NEWS",
                        "1 => NOWY EPIZOD",
                        "2 => POWIADOMIENIE LAUDA",
                        "3 => POWIADOMIENIE NA KANALE MODERATOROW",
                        "4 => NOWY SEZONOWY EPIZOD",
                        "5 => POWIADOMIENIE ADMINISTRATOROW"
                    ],
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "RichMessageAuthor": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Laudemort"
                },
                "isAuthor": {
                    "type": "boolean",
                    "example": true
                },
                "imageUrl": {
                    "type": "string",
                    "example": "https://shinden.pl/res/avatars/225x350/41.jpg?v1"
                }
            }
        },
        "RichMessageFooter": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "example": "Dodano: 1.1.1970"
                },
                "isFooter": {
                    "type": "boolean",
                    "example": true
                },
                "imageUrl": {
                    "type": "string",
                    "example":"https://shinden.pl/res/avatars/225x350/41.jpg?v1"
                }
            }
        },
        "RichMessageFields": {
            "type": "object",
            "properties": {
                "hasFields": {
                    "type": "boolean",
                    "example": true
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RichMessageField"
                    }
                }
            }
        },
        "RichMessageField": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Ocena"
                },
                "value": {
                    "type": "string",
                    "example": "10/10"
                },
                "isInline": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "BotUser": {
            "type": "object",
            "properties": {
                "user_id": {
                    "$ref": "#/definitions/UserID"
                },
                "discord_user_attributes": {
                    "$ref": "#/definitions/DiscordUserAttributes"
                },
                "discord_user_achievements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/AchievementBase"
                    }
                },
                "custom_bg": {
                    "type": "boolean"
                },
                "bg_image": {
                    "type": "string"
                },
                "inside_type": {
                    "format": "int32",
                    "enum": [
                        0,
                        1
                    ],
                    "type": "integer"
                },
                "custom_in_img": {
                    "type": "boolean"
                },
                "in_image": {
                    "type": "string"
                },
                "used_wheel": {
                    "format": "date-time",
                    "type": "string"
                },
                "used_hourly": {
                    "format": "date-time",
                    "type": "string"
                },
                "can_gamble": {
                    "type": "boolean"
                },
                "broken": {
                    "type": "boolean"
                },
                "premium": {
                    "format": "date-time",
                    "type": "string"
                },
                "rep_giv": {
                    "format": "int32",
                    "type": "integer"
                },
                "bankrupt_to": {
                    "format": "date-time",
                    "type": "string"
                }
            }
        },
        "UserID": {
            "type": "object",
            "properties": {
                "discord_id": {
                    "format": "int64",
                    "type": "integer",
                    "example": 213232131231
                },
                "shinden_id": {
                    "format": "int64",
                    "type": "integer",
                    "example": 85
                }
            }
        },
        "DiscordUserAttributes": {
            "type": "object",
            "properties": {
                "user_exp_points": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_level": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_messeges": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_reputation": {
                    "format": "int64",
                    "type": "integer"
                },
                "user_reputation_last_time_granted": {
                    "format": "date-time",
                    "type": "string"
                },
                "user_wallet": {
                    "format": "int64",
                    "type": "integer"
                },
                "wallet_daily_used": {
                    "format": "date-time",
                    "type": "string"
                },
                "money_lost_on_lottery": {
                    "format": "int64",
                    "type": "integer"
                }
            }
        },
        "AchievementBase": {
            "type": "object",
            "properties": {
                "ach_type": {
                    "format": "int32",
                    "enum": [
                        0,
                        1,
                        2,
                        3,
                        4,
                        5,
                        6,
                        7
                    ],
                    "type": "integer"
                },
                "ach_value": {
                    "format": "int64",
                    "type": "integer"
                },
                "ach_event": {
                    "type": "string"
                }
            }
        }
    }
}