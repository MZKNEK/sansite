# The pictures in i/ live only on the server; the explorer that shows them is part of the site
/i/*
!/i/index.php

# Discord application secret and the gallery admins, only on the server
/inc/config.php

# Gallery access added in the admin panel and recent logins, written by PHP
/inc/data/

# Source maps of bundled scripts and stylesheets, only for the browser's dev tools
*.map

# The packages of Skalpelator and USkalpelator (apps/), installed by npm for their build
node_modules/
