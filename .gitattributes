# Not part of the site on the server; deploy.sh sends what git archive gives
deploy.sh export-ignore
README.md export-ignore
server/ export-ignore
tools/ export-ignore
tests/ export-ignore
.github/ export-ignore
.gitignore export-ignore
.gitattributes export-ignore

# the deploy script runs in bash, also on Windows
*.sh text eol=lf

# The site runs on Linux and deploy sends the repository content (git archive),
# so keep every text file LF both in the repository and in the working tree; git
# still detects binary files (fonts, pictures) and leaves them untouched
* text=auto eol=lf
